# Dependencies
/node_modules

# Next.js
/.next/
/out/

# Env files (real Firebase keys live here — see README step 4)
.env
.env.local
.env*.local

# ---------------- Step 10 — Capacitor / Android ----------------
# The native Android project is generated by `npx cap add android` and
# regenerated on every `npm run cap:sync` — don't commit its build output
# or local machine config (keystores, local.properties point at your own
# Android SDK path).
/android/app/build/
/android/build/
/android/.gradle/
/android/local.properties
/android/*.iml
/android/.idea/
/android/app/*.iml
/android/captures/
/android/app/release/
# Keystore for signing release APKs — NEVER commit this
*.keystore
*.jks

# Misc
.DS_Store
*.log
