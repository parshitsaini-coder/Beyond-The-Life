rules_version = '2';

// Deploy: Firebase Console -> Firestore Database -> Rules -> paste this -> Publish
// (or via CLI: firebase deploy --only firestore:rules, if you set up the Firebase CLI)

service cloud.firestore {
  match /databases/{database}/documents {

    // Each user has exactly one document at btl_state/{their own uid}.
    // request.auth.uid must match the document ID for any read/write.
    match /btl_state/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
